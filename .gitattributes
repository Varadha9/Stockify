# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Java sources
*.java text diff=java

# Gradle files
*.gradle text
*.gradle.kts text
gradle.properties text
gradlew text eol=lf
gradlew.bat text eol=crlf

# XML files
*.xml text

# JSON & YAML
*.json text
*.yml text
*.yaml text
*.toml text

# Markdown & Docs
*.md text
*.txt text
LICENSE text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
