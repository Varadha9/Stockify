<resources>

    <!-- ── Shape appearances ── -->
    <style name="ShapeAppearance.Stockify.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.Stockify.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.Stockify.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.Stockify.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ── Text input — focused stroke uses brand primary ── -->
    <style name="Widget.Stockify.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Stockify.Small</item>
        <item name="hintTextColor">@color/brand_primary</item>
    </style>

    <!-- ── Buttons ── -->
    <style name="Widget.Stockify.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Stockify.Medium</item>
        <item name="backgroundTint">@color/brand_primary</item>
    </style>
    <style name="Widget.Stockify.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Stockify.Medium</item>
        <item name="strokeColor">@color/neutral_200</item>
    </style>
    <style name="Widget.Stockify.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Stockify.Medium</item>
        <item name="backgroundTint">@color/color_error</item>
    </style>

    <!-- ── Cards ── -->
    <style name="Widget.Stockify.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="strokeColor">@color/neutral_100</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ── Text appearances ── -->
    <style name="MyTextStyle"    parent="TextAppearance.Material3.BodyLarge"/>
    <style name="MyTitleStyle"   parent="TextAppearance.Material3.TitleLarge"/>
    <style name="MyBodyStyle"    parent="TextAppearance.Material3.BodyLarge"/>
    <style name="MyHeadline6"    parent="TextAppearance.Material3.HeadlineSmall"/>
    <style name="MyHeadline5"    parent="TextAppearance.Material3.HeadlineMedium"/>
    <style name="MyCaption"      parent="TextAppearance.Material3.BodySmall"/>

    <!-- ── Bottom nav ── -->
    <style name="BottomNavigationTheme" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="itemIconSize">24dp</item>
        <item name="elevation">8dp</item>
    </style>

</resources>
