<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Stockify" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_surface</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/color_success</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="colorSecondaryContainer">@color/color_success_bg</item>
        <item name="colorOnSecondaryContainer">#005C45</item>
        <item name="colorTertiary">#A855F7</item>
        <item name="colorError">@color/color_error</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/surface_bg</item>
        <item name="colorOnBackground">@color/text_heading</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_heading</item>
        <item name="colorOutline">@color/neutral_200</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/gradient_start</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Keyboard behavior — push content up -->
        <item name="android:windowSoftInputMode">adjustResize</item>

        <!-- Ripple -->
        <item name="android:colorControlHighlight">#1A6C63FF</item>
    </style>

    <style name="zxing_CaptureTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
